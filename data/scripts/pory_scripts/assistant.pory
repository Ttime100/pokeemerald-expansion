        }
        else {
        playfanfare(MUS_RG_OBTAIN_KEY_ITEM) //TODO not finalized
        msgbox(format("{STR_VAR_1}'s gender has been changed!"))
        waitfanfare
        return
        }
    //}
    //else{
    //    msgbox(format("I'm sorry, I cannot change this Pokémon."))
    //    return
    //}
}

script Assistant_LowerIVs {
    msgbox(format("I can lower one of your Pokémon's IVs to 0. Which Pokémon should I modify?"))
    special(ChoosePartyMon)
    waitstate
    lock
    faceplayer
    if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN){
    return
    }
    copyvar(PARTY_MON, VAR_0x8004)
    bufferpartymonnick(STR_VAR_1, PARTY_MON)
    msgbox(format("Which stat should be lowered?"))
    dynmultipush("HP", STAT_HP)
    dynmultipush("Attack", STAT_ATK)
    dynmultipush("Defense", STAT_DEF)
    dynmultipush("Sp. Atk", STAT_SPATK)
    dynmultipush("Sp. Def", STAT_SPDEF)
    dynmultipush("Speed", STAT_SPEED)
    dynmultistack(0, 0, FALSE, 6, FALSE, STAT_HP, 0)
    if(var(VAR_RESULT) == MULTI_B_PRESSED){
    return
    }
    copyvar(MON_STAT, VAR_RESULT)
    if(var(MON_STAT) == STAT_HP) { bufferstring(STR_VAR_2, "HP") }
    if(var(MON_STAT) == STAT_ATK) { bufferstring(STR_VAR_2, "Attack") }
    if(var(MON_STAT) == STAT_DEF) { bufferstring(STR_VAR_2, "Defense") }
    if(var(MON_STAT) == STAT_SPATK) { bufferstring(STR_VAR_2, "Sp. Atk") }
    if(var(MON_STAT) == STAT_SPDEF) { bufferstring(STR_VAR_2, "Sp. Def") }
    if(var(MON_STAT) == STAT_SPEED) { bufferstring(STR_VAR_2, "Speed") }
    special(LowerMonIV)
    playse(SE_M_MINIMIZE)
    msgbox(format("{STR_VAR_1}'s {STR_VAR_2} IV has been lowered!"))
    waitse
    return
}
