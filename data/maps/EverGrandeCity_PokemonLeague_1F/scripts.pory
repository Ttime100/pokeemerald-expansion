raw`
EverGrandeCity_PokemonLeague_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, EverGrandeCity_PokemonLeague_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

EverGrandeCity_PokemonLeague_1F_OnTransition:
	setrespawn HEAL_LOCATION_EVER_GRANDE_CITY_POKEMON_LEAGUE
	setflag FLAG_LANDMARK_POKEMON_LEAGUE
	call_if_unset FLAG_ENTERED_ELITE_FOUR, EverGrandeCity_PokemonLeague_1F_EventScript_GuardsBlockDoor
	end

EverGrandeCity_PokemonLeague_1F_EventScript_GuardsBlockDoor::
	setobjectxyperm LOCALID_LEAGUE_GUARD_1, 9, 2
	setobjectxyperm LOCALID_LEAGUE_GUARD_2, 10, 2
	return

EverGrandeCity_PokemonLeague_1F_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_LEAGUE_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end

EverGrandeCity_PokemonLeague_1F_EventScript_Clerk::
	lock
	faceplayer
	message gText_HowMayIServeYou
	waitmessage
	pokemart EverGrandeCity_PokemonLeague_1F_Pokemart
	msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
	release
	end

	.align 2
EverGrandeCity_PokemonLeague_1F_Pokemart:
	.2byte ITEM_ULTRA_BALL
	.2byte ITEM_HYPER_POTION
	.2byte ITEM_MAX_POTION
	.2byte ITEM_FULL_RESTORE
	.2byte ITEM_FULL_HEAL
	.2byte ITEM_REVIVE
	.2byte ITEM_MAX_REPEL
	pokemartlistend

@ The door guards only check for FLAG_BADGE06_GET because Winonas badge is the only one that can be skipped
@ Its assumed the player has the remaining badges
EverGrandeCity_PokemonLeague_1F_EventScript_DoorGuard::
	lockall
	goto_if_set FLAG_ENTERED_ELITE_FOUR, EverGrandeCity_PokemonLeague_1F_EventScript_GoForth
	getplayerxy VAR_TEMP_0, VAR_TEMP_1
	call_if_ge VAR_TEMP_0, 11, EverGrandeCity_PokemonLeague_1F_EventScript_PlayerMoveToFrontFromRight
	call_if_le VAR_TEMP_0, 8, EverGrandeCity_PokemonLeague_1F_EventScript_PlayerMoveToFrontFromLeft
	message EverGrandeCity_PokemonLeague_1F_Text_MustHaveAllGymBadges
	waitmessage
	delay 120
	goto_if_unset FLAG_BADGE06_GET, EverGrandeCity_PokemonLeague_1F_EventScript_NotAllBadges
	closemessage
	applymovement LOCALID_LEAGUE_GUARD_1, EverGrandeCity_PokemonLeague_1F_Movement_LeftGuardOutOfWay
	applymovement LOCALID_LEAGUE_GUARD_2, EverGrandeCity_PokemonLeague_1F_Movement_RightGuardOutOfWay
	waitmovement 0
	delay 10
	playfanfare MUS_OBTAIN_BADGE
	message EverGrandeCity_PokemonLeague_1F_Text_GoForth
	waitmessage
	waitfanfare
	closemessage
	copyobjectxytoperm LOCALID_LEAGUE_GUARD_1
	copyobjectxytoperm LOCALID_LEAGUE_GUARD_2
	setflag FLAG_ENTERED_ELITE_FOUR
	releaseall
	end

EverGrandeCity_PokemonLeague_1F_EventScript_PlayerMoveToFrontFromRight::
	applymovement LOCALID_PLAYER, EverGrandeCity_PokemonLeague_1F_Movement_MoveToFrontFromRight
	waitmovement 0
	return

EverGrandeCity_PokemonLeague_1F_EventScript_PlayerMoveToFrontFromLeft::
	applymovement LOCALID_PLAYER, EverGrandeCity_PokemonLeague_1F_Movement_MoveToFrontFromLeft
	waitmovement 0
	return

EverGrandeCity_PokemonLeague_1F_EventScript_NotAllBadges::
	playse SE_FAILURE
	msgbox EverGrandeCity_PokemonLeague_1F_Text_HaventObtainedAllBadges, MSGBOX_DEFAULT
	releaseall
	end

EverGrandeCity_PokemonLeague_1F_EventScript_GoForth::
	applymovement VAR_LAST_TALKED, Common_Movement_FacePlayer
	waitmovement 0
	msgbox EverGrandeCity_PokemonLeague_1F_Text_GoForth, MSGBOX_DEFAULT
	closemessage
	applymovement VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection
	waitmovement 0
	releaseall
	end

EverGrandeCity_PokemonLeague_1F_Movement_MoveToFrontFromRight:
	walk_down
	walk_left
	walk_in_place_faster_up
	step_end

EverGrandeCity_PokemonLeague_1F_Movement_MoveToFrontFromLeft:
	walk_down
	walk_right
	walk_in_place_faster_up
	step_end

EverGrandeCity_PokemonLeague_1F_Movement_LeftGuardOutOfWay:
	walk_left
	walk_in_place_faster_down
	step_end

EverGrandeCity_PokemonLeague_1F_Movement_RightGuardOutOfWay:
	walk_right
	walk_in_place_faster_down
	step_end

EverGrandeCity_PokemonLeague_1F_Text_MustHaveAllGymBadges:
	.string "Beyond this point, only those Trainers\n"
	.string "who have collected all the Gym Badges\l"
	.string "are permitted to enter.\p"
	.string "Trainer, let us confirm that you have\n"
	.string "all the Gym Badges.$"

EverGrandeCity_PokemonLeague_1F_Text_HaventObtainedAllBadges:
	.string "You haven't obtained all the Badges.\p"
	.string "If you're bound for the Pokémon\n"
	.string "League, you must return with them.$"

EverGrandeCity_PokemonLeague_1F_Text_GoForth:
	.string "Trainer! Believe in yourself and your\n"
	.string "Pokémon, and go forth!$"

`
script EverGrandeCity_PokemonLeague_EventScript_Gatekeeper {
    lock
    faceplayer
    
    if (flag(FLAG_MET_GATEKEEPERS)) {
        goto(EverGrandeCity_PokemonLeague_CheckProgress)
    }
    msgbox(EverGrandeCity_PokemonLeague_1F_Text_MustHaveAllGymBadges)
    playse(SE_PIN)
    applymovement(3, Common_Movement_ExclamationMark)
    applymovement(4, Common_Movement_ExclamationMark)
    waitmovement(3)
    waitmovement(4)
    delay(60)
    playse(SE_DOOR)
    playbgm(MUS_ENCOUNTER_ELITE_FOUR, FALSE)
    clearflag(FLAG_HIDE_TYLER_LEAGUE)
    addobject(5)
    delay(30)
    msgbox(EverGrandeCity_PokemonLeague_Text_TylersChallenge)
    clearflag(FLAG_HIDE_EXILED_ELITE_FOUR)
	clearflag(FLAG_HIDE_HINT_GIVER)
    setflag(FLAG_MET_GATEKEEPERS)
    applymovement(5, Common_Movement_FaceUp)
    waitmovement(5)
    delay(20)
    removeobject(5)
    playse(SE_DOOR)
    setflag(FLAG_HIDE_TYLER_LEAGUE)
    fadedefaultbgm
    release
    end
}

script EverGrandeCity_PokemonLeague_CheckProgress {
    if (flag(FLAG_DEFEATED_ELITE_4_SIDNEY) && flag(FLAG_DEFEATED_ELITE_4_PHOEBE)
    && flag(FLAG_DEFEATED_ELITE_4_GLACIA) && flag(FLAG_DEFEATED_ELITE_4_DRAKE)) {
        call(EverGrandeCity_PokemonLeague_1F_EventScript_DoorGuard)
    }
    else {
        msgbox(format("I'm sorry {PLAYER}.\p"
               "It sounds like you need to defeat the former members before returning."))
    }
    release
    end
}

script EverGrandeCity_PokemonLeague_HintGiver {
	lock
	faceplayer
	if(flag(FLAG_TEMP_1)) {
		msgbox(format("Back for another lead?"))
	} else {
		msgbox(format("The League has been taken over.\nIt's a mess.\p
		The original Elite Four have scattered across Hoenn,
		but thankfully there are murmurings on where they disappeared."))
		setflag(FLAG_TEMP_1)
	}
	setvar(VAR_TEMP_5, 0)
    if (!flag(FLAG_DEFEATED_ELITE_4_SIDNEY)) { addvar(VAR_TEMP_5, 1) }
    if (!flag(FLAG_DEFEATED_ELITE_4_PHOEBE)) { addvar(VAR_TEMP_5, 1) }
    if (!flag(FLAG_DEFEATED_ELITE_4_GLACIA)) { addvar(VAR_TEMP_5, 1) }
    if (!flag(FLAG_DEFEATED_ELITE_4_DRAKE))  { addvar(VAR_TEMP_5, 1) }
	if(var(VAR_TEMP_5) == 0) {
		msgbox(format("You've found them all!\nGo reclaim the League!"))
		release
		end
	}
	random(VAR_TEMP_5)
	setvar(VAR_TEMP_6, 0)
    if (!flag(FLAG_DEFEATED_ELITE_4_SIDNEY)) {
        if (var(VAR_TEMP_6) == VAR_RESULT) {
            msgbox(EverGrandeCity_PokemonLeague_Text_SidneyHint)
            release
            end
        }
        addvar(VAR_TEMP_6, 1)
    }
    if (!flag(FLAG_DEFEATED_ELITE_4_PHOEBE)) {
        if (var(VAR_TEMP_6) == VAR_RESULT) {
            msgbox(EverGrandeCity_PokemonLeague_Text_PhoebeHint)
            release
            end
        }
        addvar(VAR_TEMP_6, 1)
    }
    if (!flag(FLAG_DEFEATED_ELITE_4_GLACIA)) {
        if (var(VAR_TEMP_6) == VAR_RESULT) {
            msgbox(EverGrandeCity_PokemonLeague_Text_GlaciaHint)
            release
            end
        }
        addvar(VAR_TEMP_6, 1)
    }
    if (!flag(FLAG_DEFEATED_ELITE_4_DRAKE)) {
        if (var(VAR_TEMP_6) == VAR_RESULT) {
            msgbox(EverGrandeCity_PokemonLeague_Text_DrakeHint)
            release
            end
        }
        addvar(VAR_TEMP_6, 1)
    }
	release
	end
}

text EverGrandeCity_PokemonLeague_Text_TylersChallenge {
	format("I'll handle this.\p
           So, this is the challenger\n
           I've been hearing about?\p
           You look rather ordinary.\p
           You think a few gym badges make you worthy
           of standing in our presence?\p
           We replaced the former Elite Four\n
           because they didn't have what it takes.\p
           If you want us to even
           consider opening these doors,
           you'll have to prove you're
           at least better than them.\p
           They have retreated to the\n
           far corners of Hoenn.\p
           Defeat them. All of them.\p
           Only then will I consider you\n
           as a legitimate challenger.")
}

text EverGrandeCity_PokemonLeague_Text_SidneyHint {
	format("Sidney was last spotted near the coast,\n
	somewhere where shadows never fade.\p
	If you look for the place where light is swallowed by the sea, you'll find him.")
}

text EverGrandeCity_PokemonLeague_Text_PhoebeHint {
	format("Phoebe hasn't been seen for a while.\n
	They say she's returned to the tower where spirits gather,
	waiting at the highest point to pay her respects.")
}

text EverGrandeCity_PokemonLeague_Text_GlaciaHint {
	format("There's a strange chill lingering in the northern waters.
	Look for the place where the land turns to permafrost.
	That is where Glacia is keeping watch.")
}

text EverGrandeCity_PokemonLeague_Text_DrakeHint {
	format("Drake has retreated to his training grounds deep within the caves.\p
	He dwells where Dragon Pokémon raise their young amongst ancient meteors.")
}


