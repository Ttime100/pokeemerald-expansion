raw`ShadespurPokemonCenter_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, ShadespurPokemonCenter_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

ShadespurPokemonCenter_OnTransition:
	setrespawn HEAL_LOCATION_SHADESPUR_ISLE
	end

ShadespurPokemonCenter_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_SHADESPUR_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end
`
script ShadespurPokemonCenter_EventScript_Aqua_Grunt_Chats {
    lock
    faceplayer
    random (3)
    switch (var(VAR_RESULT)){
    case 0: msgbox (format("Well look what the tide dragged in.\nA fresh face.\p
        Don't worry, kid, we won't steal your Pokémon.\p
        We're done with all that. We just…\n
        ran out of oceans to conquer."))
    case 1: msgbox (format("The hardest part of leaving?\nThe quiet.\p
        No more yelling, no more rushed orders,
        no being treated like a spare anchor.\p
        This island is cold, but at least the cold is honest."))
    case 2: msgbox (format("I heard the boss is still out there,\n
        pushing for the Eternal Tide.\pGood luck to him.\p
        I just needed a place where I didn't have
        to choose between a life jacket and a jail cell.\p
        This place is far enough from everyone."))
    }
    release
    end
}

script ShadespurPokemonCenter_EventScript_Magma_Grunt_Chats {
    lock
    faceplayer
    random (3)
    switch (var(VAR_RESULT)){
    case 0: msgbox (format("You startled me.\n
        Yeah, I’m Magma. He's Aqua.\p
        We found this spot and called a truce.
        Out here, we're not teams, we're just… outcasts.\p
        Nothing worse than being a grunt without a team to back you up."))
    case 1: msgbox (format("The boss always talked about
        the perfect land, the perfect world.\p
        But the only perfect thing I ever\n
        found was a cot that didn't smell\l
        like volcanic sulfur.\p
        We’re all refugees from our own bad decisions, kid."))
    case 2: msgbox (format("You see that computer?
        It's rigged for basic healing and storage.\p
        No network. No calls back to headquarters.
        We made sure of that.\p
        This isn't just a hideout;\n
        it's a dead zone.\p
        This is where to go when the fighting gets too loud."))
    }
    release
    end
}

script ShadespurPokemonCenter_EventScript_OldManWarning {
    lock
    faceplayer
    msgbox (format("They call this place a refuge.\p
    But the shore is where you bury your debts, not pay them.\p
    Be careful who you owe, young one."))
    release
    end
}
